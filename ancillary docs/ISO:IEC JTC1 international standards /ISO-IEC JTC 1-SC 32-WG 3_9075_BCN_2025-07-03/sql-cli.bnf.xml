         <BNF name="CLI parameter data type"/>
      </rhs>
   </BNFdef>
   <BNFdef name="CLI parameter name" predicative="no">
      <rhs>
         <seeTheRules/>
      </rhs>
   </BNFdef>
   <BNFdef name="CLI parameter mode" predicative="no">
      <rhs>
         <alt>
            <kw>IN</kw>
         </alt>
         <alt>
            <kw>OUT</kw>
         </alt>
         <alt>
            <terminalsymbol>DEFIN</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>DEFOUT </terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>DEF</terminalsymbol>
         </alt>
      </rhs>
   </BNFdef>
   <BNFdef name="CLI parameter data type" predicative="no">
      <rhs>
         <alt>
            <kw>INTEGER</kw>
         </alt>
         <alt>
            <kw>SMALLINT</kw>
         </alt>
         <alt>
            <kw>ANY</kw>
         </alt>
         <alt>
            <kw>CHARACTER</kw>
            <BNF name="left paren" part="02"/>
            <BNF name="length" part="02"/>
            <BNF name="right paren" part="02"/>
         </alt>
      </rhs>
   </BNFdef>
   <BNFdef name="CLI returns clause" predicative="no">
      <rhs>
         <kw>RETURNS</kw>
         <kw>SMALLINT</kw>
      </rhs>
   </BNFdef>
   <BNFdef name="implementation-defined CLI generic name" predicative="no">
      <rhs>
         <seeTheRules/>
      </rhs>
   </BNFdef>
</grammar>
