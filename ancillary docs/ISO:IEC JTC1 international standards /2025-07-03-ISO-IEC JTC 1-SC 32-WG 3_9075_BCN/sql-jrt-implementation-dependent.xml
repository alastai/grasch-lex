<?xml version="1.0" encoding="UTF-8"?>
<!--
The following XML document is a "digital artifact" contains an XML element 
(implementationDependent) that identifies every aspect of a part of ISO/IEC 9075 that is specified to be 
"implementation-dependent".  
An XML DTD is provided that may be used to validate the XML document itself. 

The code consists of 2 characters followed by a three digit number.
The first letter of implementation-dependent codes is always U. 
This distinguishes it from the codes used for optional features and implementation-defined 
features.
The second letter of implementation-dependent codes have the following meanings:
    A Actions
    D Defaults
    L Limits
    S Sequencing
    V Values/Constants
    W Ways and means

-->



<!DOCTYPE implementationDependent [
  
<!-- The implementationDependent element defines the implementation-dependent features of 
a standard (part). -->
<!ELEMENT implementationDependent (unDef*)>

<!-- An unDef element defines a specific implementation-dependent feature. -->
<!ELEMENT unDef (code, description)>

<!-- A code element specifies the unique code for an implementation-dependent feature. -->
<!ELEMENT code (#PCDATA)>

<!-- A description element provides a textual specification of the implementation-dependent feature.
-->
<!ELEMENT description (#PCDATA)>

]>

<implementationDependent>
   <unDef>
      <code>UA003</code>
      <description>The scope and persistence of any modifications to static attributes made during the execution of a Java method.</description>
   </unDef>
   <unDef>
      <code>UA006</code>
      <description>The scope and persistence of any modifications of class variables made before the completion of any execution of the program of an external routine.</description>
   </unDef>
   <unDef>
      <code>UA007</code>
      <description>The effect of SQLJ.REPLACE_JAR on currently executing SQL statements that use an SQL routine or structured type whose implementation has been replaced.</description>
   </unDef>
   <unDef>
      <code>UA008</code>
      <description>The effect of SQLJ.REMOVE_JAR on currently executing SQL statements that use an SQL routine or structured type whose implementation has been replaced.</description>
   </unDef>
   <unDef>
      <code>UA009</code>
      <description>The effect of SQLJ.ALTER_JAVA_PATH on SQL statements that have already been prepared or are currently executing.</description>
   </unDef>
   <unDef>
      <code>UW004</code>
      <description>The manner in which the built-in procedures specified in the Signature section are defined.</description>
   </unDef>
</implementationDependent>
