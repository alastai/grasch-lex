{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grasch.org/schemas/lex-2026.0.3.2.json",
  "title": "LEX:2026.0.3.2 JSON Schema",
  "description": "JSON Schema for specifications of graph catalogs, graph schemas and graph instances, based on LEX-100r3 with mandatory labels, subtyping, and import support",
  "oneOf": [
    {
      "type": "object",
      "required": ["catalog"],
      "properties": {
        "catalog": {
          "$ref": "#/$defs/CatalogContent"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["graphSchema"],
      "properties": {
        "graphSchema": {
          "$ref": "#/$defs/GraphSchemaContent"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["graph"],
      "properties": {
        "graph": {
          "$ref": "#/$defs/GraphContent"
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "CatalogContent": {
      "type": "object",
      "description": "Graph catalog specification - a hierarchical collection of named primary catalog objects",
      "required": ["IRI"],
      "properties": {
        "IRI": {
          "type": "string",
          "format": "iri",
          "description": "IRI for global catalog identification"
        },
        "directories": {
          "oneOf": [
            {
              "type": "array",
              "description": "Inline array of directory nodes",
              "items": {
                "$ref": "#/$defs/Directory"
              }
            },
            {
              "type": "object",
              "description": "Import directories from file",
              "required": ["import"],
              "properties": {
                "import": {
                  "type": "string",
                  "description": "Import directory structure from file"
                }
              },
              "maxProperties": 1
            },
            {
              "type": "object",
              "description": "Mixed: import directories with additional inline directories",
              "required": ["import"],
              "properties": {
                "import": {
                  "type": "string"
                },
                "additionalDirectories": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Directory"
                  }
                }
              },
              "minProperties": 2
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Directory": {
      "type": "object",
      "description": "Directory node in catalog tree",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Directory name"
        },
        "directories": {
          "type": "array",
          "description": "Subdirectories",
          "items": {
            "$ref": "#/$defs/Directory"
          }
        },
        "graphReferences": {
          "type": "array",
          "description": "Graph references in this directory",
          "items": {
            "$ref": "#/$defs/GraphReference"
          }
        },
        "graphSchemaReferences": {
          "type": "array",
          "description": "Graph schema references in this directory",
          "items": {
            "$ref": "#/$defs/GraphSchemaReference"
          }
        }
      },
      "additionalProperties": false
    },
    "GraphReference": {
      "type": "object",
      "description": "Graph reference in catalog",
      "required": ["name", "qualifiedName"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Graph name"
        },
        "qualifiedName": {
          "type": "string",
          "description": "Fully qualified name for this graph"
        },
        "filePath": {
          "type": "string",
          "description": "Optional file path to graph definition"
        }
      },
      "additionalProperties": false
    },
    "GraphSchemaReference": {
      "type": "object",
      "description": "Graph schema reference in catalog",
      "required": ["name", "qualifiedName"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Graph schema name"
        },
        "qualifiedName": {
          "type": "string",
          "description": "Fully qualified name for this graph schema"
        },
        "filePath": {
          "type": "string",
          "description": "Optional file path to graph schema definition"
        }
      },
      "additionalProperties": false
    },
    "GraphSchemaContent": {
      "type": "object",
      "description": "Graph schema specification - structural graph type plus constraints",
      "required": ["pathName", "graphType"],
      "properties": {
        "pathName": {
          "type": "string",
          "description": "Path name for the graph schema"
        },
        "principal": {
          "type": "string",
          "description": "The owner of the graph schema, an authorization identifier of a principal"
        },
        "valueTypeSystemName": {
          "type": "string",
          "description": "The name of the value type system used by this graph schema (optional, defaults to CANONICAL)",
          "enum": [
            "CANONICAL",
            "CYPHER",
            "GQL",
            "SQL"
          ],
          "default": "CANONICAL"
        },
        "graphType": {
          "$ref": "#/$defs/GraphType"
        },
        "constraints": {
          "type": "object",
          "description": "A map of constraint names to constraint descriptors (optional)",
          "additionalProperties": {
            "$ref": "#/$defs/Constraint"
          }
        }
      },
      "additionalProperties": false
    },
    "GraphContent": {
      "type": "object",
      "description": "Graph instance specification - with optional schema, constraints, and storage schema",
      "required": ["pathName"],
      "properties": {
        "pathName": {
          "type": "string",
          "description": "Path name for the graph instance"
        },
        "principal": {
          "type": "string",
          "description": "The owner of the graph, an authorization identifier of a principal"
        },
        "valueTypeSystemName": {
          "type": "string",
          "description": "The name of the value type system used by this graph (optional, defaults to CANONICAL)",
          "enum": [
            "CANONICAL",
            "CYPHER",
            "GQL",
            "SQL"
          ],
          "default": "CANONICAL"
        },
        "graphSchema": {
          "oneOf": [
            {
              "type": "object",
              "description": "Inline graphSchema definition",
              "not": {
                "required": ["import"]
              },
              "properties": {
                "pathName": {
                  "type": "string",
                  "pattern": "^/.*"
                },
                "graphType": {
                  "$ref": "#/$defs/GraphType"
                }
              },
              "required": ["pathName", "graphType"]
            },
            {
              "type": "object",
              "description": "Import graphSchema from file",
              "required": ["import"],
              "properties": {
                "import": {
                  "type": "string"
                }
              },
              "maxProperties": 1
            },
            {
              "type": "object",
              "description": "Mixed: import graphSchema with overrides",
              "required": ["import"],
              "properties": {
                "import": {
                  "type": "string"
                },
                "pathName": {
                  "type": "string",
                  "pattern": "^/.*"
                },
                "graphType": {
                  "$ref": "#/$defs/GraphType"
                }
              },
              "minProperties": 2
            }
          ]
        },
        "graphStorageSchema": {
          "oneOf": [
            {
              "$ref": "#/$defs/StorageSchema",
              "description": "Inline storage schema definition"
            },
            {
              "type": "object",
              "description": "Import storage schema from file",
              "required": ["import"],
              "properties": {
                "import": {
                  "type": "string"
                }
              },
              "maxProperties": 1
            },
            {
              "type": "object",
              "description": "Mixed: import storage schema with overrides",
              "required": ["import"],
              "properties": {
                "import": {
                  "type": "string"
                },
                "storageType": {
                  "type": "string"
                }
              },
              "minProperties": 2
            }
          ]
        },
        "subtypesOfSchemaType": {
          "type": "object",
          "description": "Preserved for future work - subtype relationships"
        },
        "constraints": {
          "type": "object",
          "description": "A map of constraint names to constraint descriptors (optional)",
          "additionalProperties": {
            "$ref": "#/$defs/Constraint"
          }
        }
      },
      "additionalProperties": false
    },
    "StorageSchema": {
      "type": "object",
      "description": "Storage schema for graph serialization - placeholder for future GraphAr integration",
      "properties": {
        "storageType": {
          "type": "string",
          "description": "Storage type identifier (e.g., file format)"
        }
      },
      "additionalProperties": true
    },
    "GraphType": {
      "type": "object",
      "description": "Graph type descriptor defining the structural graph type",
      "required": ["defaults"],
      "properties": {
        "pathName": {
          "type": "string",
          "pattern": "^/.*",
          "description": "Optional path name (only present if graphType is imported)"
        },
        "graphPreferredName": {
          "type": "string",
          "enum": [
            "GRAPH",
            "PROPERTY GRAPH"
          ],
          "description": "Implementation-defined preferred name for graph"
        },
        "nodePreferredName": {
          "type": "string",
          "enum": [
            "NODE",
            "VERTEX"
          ],
          "description": "Implementation-defined preferred name for nodes"
        },
        "edgePreferredName": {
          "type": "string",
          "enum": [
            "EDGE",
            "RELATIONSHIP"
          ],
          "description": "Implementation-defined preferred name for edges"
        },
        "nodeTypeMinimumLabels": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Minimum number of labels for node types (LEX:2026.0.3 - now mandatory, minimum 1)"
        },
        "nodeTypeMaximumLabels": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of labels for node types"
        },
        "nodeTypeMinimumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of property types for node types"
        },
        "nodeTypeMaximumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of property types for node types"
        },
        "edgeTypeMinimumLabels": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Minimum number of labels for edge types (LEX:2026.0.3 - now mandatory, minimum 1)"
        },
        "edgeTypeMaximumLabels": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of labels for edge types"
        },
        "edgeTypeMinimumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of property types for edge types"
        },
        "edgeTypeMaximumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of property types for edge types"
        },
        "typeInterpretation": {
          "type": "string",
          "enum": [
            "exactlyOfThisType",
            "anySubtypeOf",
            "anyProperSubtypeOf"
          ],
          "default": "exactlyOfThisType",
          "description": "How types are interpreted during validation (LEX:2026.0.3)"
        },
        "import": {
          "type": "string",
          "description": "Import file path for graph type defaults"
        },
        "nodeTypes": {
          "oneOf": [
            {
              "type": "array",
              "description": "Inline array of node type descriptors",
              "items": {
                "$ref": "#/$defs/NodeType"
              }
            },
            {
              "type": "object",
              "description": "Import node types from file",
              "required": ["import"],
              "properties": {
                "import": {
                  "type": "string",
                  "description": "Import all node types from file"
                }
              },
              "maxProperties": 1
            }
          ]
        },
        "allowSubtypesOf": {
          "type": "object",
          "description": "Allow subtypes of specified element types (covariant matching)",
          "properties": {
            "abstractSupertypes": {
              "type": "object",
              "description": "Abstract supertypes that cannot be instantiated directly",
              "properties": {
                "nodeTypes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/NodeType"
                  }
                },
                "edgeTypes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/EdgeType"
                  }
                }
              },
              "additionalProperties": false
            },
            "nodeTypes": {
              "type": "array",
              "description": "Node types that allow subtypes (supertype can be instantiated)",
              "items": {
                "$ref": "#/$defs/NodeType"
              }
            },
            "edgeTypes": {
              "type": "array",
              "description": "Edge types that allow subtypes (supertype can be instantiated)",
              "items": {
                "$ref": "#/$defs/EdgeType"
              }
            }
          },
          "additionalProperties": false
        },
        "edgeTypes": {
          "oneOf": [
            {
              "type": "array",
              "description": "Inline array of edge type descriptors",
              "items": {
                "$ref": "#/$defs/EdgeType"
              }
            },
            {
              "type": "object",
              "description": "Import edge types from file",
              "required": ["import"],
              "properties": {
                "import": {
                  "type": "string",
                  "description": "Import all edge types from file"
                }
              },
              "maxProperties": 1
            }
          ]
        },
        "defaults": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "import": {
                  "type": "string",
                  "description": "Import file path for default values"
                }
              },
              "required": [
                "import"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Inline default values for graph type",
              "properties": {
                "graphPreferredName": {
                  "type": "string"
                },
                "nodePreferredName": {
                  "type": "string"
                },
                "edgePreferredName": {
                  "type": "string"
                },
                "nodeTypeMinimumLabels": {
                  "type": "integer",
                  "minimum": 0
                },
                "nodeTypeMaximumLabels": {
                  "type": "integer",
                  "minimum": 1
                },
                "nodeTypeMinimumPropertyTypes": {
                  "type": "integer",
                  "minimum": 0
                },
                "nodeTypeMaximumPropertyTypes": {
                  "type": "integer",
                  "minimum": 0
                },
                "edgeTypeMinimumLabels": {
                  "type": "integer",
                  "minimum": 0
                },
                "edgeTypeMaximumLabels": {
                  "type": "integer",
                  "minimum": 1
                },
                "edgeTypeMinimumPropertyTypes": {
                  "type": "integer",
                  "minimum": 0
                },
                "edgeTypeMaximumPropertyTypes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "NodeType": {
      "type": "object",
      "description": "Node type descriptor with flexible identification (LEX:2026.0.3.2 - labels optional when matching typeLabel)",
      "properties": {
        "nodeType": {
          "type": "object",
          "description": "Node type container with identifier and implies or extends",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "nodeTypeIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Integer index for node type identification"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                }
              },
              "required": [
                "nodeTypeIndex",
                "implies"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeLabel": {
                  "type": "string",
                  "pattern": "^[a-zA-Z]",
                  "description": "Single label that serves as type name (preferred in LEX:2026.0.3)"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                }
              },
              "required": [
                "typeLabel",
                "implies"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeLabel": {
                  "type": "string",
                  "pattern": "^[a-zA-Z]",
                  "description": "Single label that serves as type name"
                },
                "extends": {
                  "type": "array",
                  "description": "Supertypes this type extends (synonym for supertypes)",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "adding": {
                  "$ref": "#/$defs/AddingDescriptor"
                }
              },
              "required": [
                "typeLabel",
                "extends"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeIdentifyingLabels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z]"
                  },
                  "uniqueItems": true,
                  "minItems": 1,
                  "description": "Set of labels that uniquely identify this type"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                }
              },
              "required": [
                "typeIdentifyingLabels",
                "implies"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "nodeType"
      ],
      "additionalProperties": false
    },
    "ImpliesDescriptor": {
      "type": "object",
      "description": "Container for supertypes, labels, and property types (LEX:2026.0.3 structure)",
      "properties": {
        "supertypes": {
          "type": "array",
          "description": "Set of supertype labels (LEX:2026.0.3 - enables subtyping)",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "labels": {
          "type": "array",
          "description": "Set of labels for this type (optional if only typeLabel)",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "propertyTypes": {
          "oneOf": [
            {
              "type": "array",
              "description": "Set of property type descriptors",
              "items": {
                "$ref": "#/$defs/PropertyType"
              }
            },
            {
              "type": "string",
              "pattern": "^\\$ref\\(",
              "description": "Import property types via $ref"
            }
          ]
        },
        "extensionInterpretation": {
          "type": "object",
          "description": "Controls whether type can be extended (LEX:2026.0.3)",
          "properties": {
            "open": {
              "type": "boolean",
              "description": "If true, allows undefined subtypes"
            },
            "closed": {
              "type": "boolean",
              "description": "If true, only defined subtypes allowed (default)"
            }
          },
          "oneOf": [
            {
              "required": [
                "open"
              ]
            },
            {
              "required": [
                "closed"
              ]
            }
          ]
        }
      },
      "required": [
        "propertyTypes"
      ],
      "additionalProperties": false
    },
    "AddingDescriptor": {
      "type": "object",
      "description": "Container for labels and property types being added to a supertype (used with extends)",
      "properties": {
        "labels": {
          "type": "array",
          "description": "Additional labels beyond typeLabel (typeLabel never included)",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "propertyTypes": {
          "type": "array",
          "description": "New property types being added (inherited properties not included)",
          "items": {
            "$ref": "#/$defs/PropertyType"
          }
        }
      },
      "additionalProperties": false
    },
    "NodeTypeIdentifier": {
      "description": "Flexible node type identification - index, type name label, or type identifying labels",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "nodeTypeIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "Integer index for node type identification"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "description": "Integer index for node type identification (synonym for nodeTypeIndex)"
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "index"
              ]
            },
            {
              "required": [
                "nodeTypeIndex"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "typeLabel": {
              "type": "string",
              "pattern": "^[a-zA-Z]",
              "description": "Single label that serves as type name (preferred in LEX:2026.0.3)"
            }
          },
          "required": [
            "typeLabel"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "typeIdentifyingLabels": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z]"
              },
              "uniqueItems": true,
              "minItems": 1,
              "description": "Set of labels that uniquely identify this type"
            }
          },
          "required": [
            "typeIdentifyingLabels"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EdgeType": {
      "type": "object",
      "description": "Edge type descriptor with flexible identification (LEX:2026.0.3.2 - labels optional when matching typeLabel)",
      "properties": {
        "edgeType": {
          "type": "object",
          "description": "Edge type container with identifier, implies, direction, and endpoints",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "edgeTypeIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Integer index for edge type identification"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "DIRECTED",
                    "UNDIRECTED"
                  ],
                  "description": "Edge direction"
                },
                "firstEndpointNodeType": {
                  "$ref": "#/$defs/NodeTypeIdentifier",
                  "description": "First endpoint node type identifier"
                },
                "secondEndpointNodeType": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "SAME"
                      ],
                      "description": "Same as first endpoint (loop edge)"
                    },
                    {
                      "$ref": "#/$defs/NodeTypeIdentifier",
                      "description": "Second endpoint node type identifier"
                    }
                  ]
                }
              },
              "required": [
                "edgeTypeIndex",
                "implies",
                "direction",
                "firstEndpointNodeType",
                "secondEndpointNodeType"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeLabel": {
                  "type": "string",
                  "pattern": "^[a-zA-Z]",
                  "description": "Single label that serves as type name (preferred in LEX:2026.0.3)"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "DIRECTED",
                    "UNDIRECTED"
                  ],
                  "description": "Edge direction"
                },
                "firstEndpointNodeType": {
                  "$ref": "#/$defs/NodeTypeIdentifier",
                  "description": "First endpoint node type identifier"
                },
                "secondEndpointNodeType": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "SAME"
                      ],
                      "description": "Same as first endpoint (loop edge)"
                    },
                    {
                      "$ref": "#/$defs/NodeTypeIdentifier",
                      "description": "Second endpoint node type identifier"
                    }
                  ]
                }
              },
              "required": [
                "typeLabel",
                "implies",
                "direction",
                "firstEndpointNodeType",
                "secondEndpointNodeType"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeIdentifyingLabels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z]"
                  },
                  "uniqueItems": true,
                  "minItems": 1,
                  "description": "Set of labels that uniquely identify this type"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "DIRECTED",
                    "UNDIRECTED"
                  ],
                  "description": "Edge direction"
                },
                "firstEndpointNodeType": {
                  "$ref": "#/$defs/NodeTypeIdentifier",
                  "description": "First endpoint node type identifier"
                },
                "secondEndpointNodeType": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "SAME"
                      ],
                      "description": "Same as first endpoint (loop edge)"
                    },
                    {
                      "$ref": "#/$defs/NodeTypeIdentifier",
                      "description": "Second endpoint node type identifier"
                    }
                  ]
                }
              },
              "required": [
                "typeIdentifyingLabels",
                "implies",
                "direction",
                "firstEndpointNodeType",
                "secondEndpointNodeType"
              ],
