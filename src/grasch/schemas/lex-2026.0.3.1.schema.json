{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grasch.org/schemas/lex-2026.0.3.json",
  "title": "LEX:2026.0.3 JSON Schema",
  "description": "JSON Schema for specifications of graph catalogs, graph schemas and graph instances, based on LEX-100r3 with mandatory labels, subtyping, and import support",
  "oneOf": [
    {
      "$ref": "#/$defs/Catalog"
    },
    {
      "$ref": "#/$defs/GraphSchema"
    },
    {
      "$ref": "#/$defs/Graph"
    }
  ],
  "$defs": {
    "Catalog": {
      "type": "object",
      "description": "Graph catalog specification - a hierarchical collection of named primary catalog objects",
      "properties": {
        "catalog": {
          "type": "object",
          "properties": {
            "IRI": {
              "type": "string",
              "format": "iri",
              "description": "Optional IRI for global catalog identification"
            },
            "directories": {
              "type": "array",
              "description": "Directory nodes in the catalog tree",
              "items": {
                "$ref": "#/$defs/Directory"
              }
            },
            "graphs": {
              "type": "array",
              "description": "Graph objects in the catalog",
              "items": {
                "$ref": "#/$defs/CatalogGraph"
              }
            },
            "graphSchemas": {
              "type": "array",
              "description": "Graph schema objects in the catalog",
              "items": {
                "$ref": "#/$defs/CatalogGraphSchema"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["catalog"],
      "additionalProperties": false
    },
    "Directory": {
      "type": "object",
      "description": "Directory node in catalog tree",
      "properties": {
        "name": {
          "type": "string",
          "description": "Directory name"
        },
        "qualifiedName": {
          "type": "string",
          "description": "LQON or GQON for this directory"
        },
        "directories": {
          "type": "array",
          "description": "Subdirectories",
          "items": {
            "$ref": "#/$defs/Directory"
          }
        },
        "graphs": {
          "type": "array",
          "description": "Graph objects in this directory",
          "items": {
            "$ref": "#/$defs/CatalogGraph"
          }
        },
        "graphSchemas": {
          "type": "array",
          "description": "Graph schema objects in this directory",
          "items": {
            "$ref": "#/$defs/CatalogGraphSchema"
          }
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "CatalogGraph": {
      "type": "object",
      "description": "Graph object reference in catalog",
      "properties": {
        "name": {
          "type": "string",
          "description": "Graph name"
        },
        "qualifiedName": {
          "type": "string",
          "description": "LQON or GQON for this graph"
        },
        "file": {
          "type": "string",
          "pattern": "^\\$ref\\(",
          "description": "Optional file reference using $ref('path') syntax"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "CatalogGraphSchema": {
      "type": "object",
      "description": "Graph schema object reference in catalog",
      "properties": {
        "name": {
          "type": "string",
          "description": "Graph schema name"
        },
        "qualifiedName": {
          "type": "string",
          "description": "LQON or GQON for this graph schema"
        },
        "file": {
          "type": "string",
          "pattern": "^\\$ref\\(",
          "description": "Optional file reference using $ref('path') syntax"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "GraphSchema": {
      "type": "object",
      "description": "Graph schema specification - structural graph type plus constraints",
      "properties": {
        "pathName": {
          "type": "string",
          "description": "Path name for the graph schema"
        },
        "principal": {
          "type": "string",
          "description": "The owner of the graph schema, an authorization identifier of a principal"
        },
        "valueTypeSystemName": {
          "type": "string",
          "description": "The name of the value type system used by this graph schema (optional, defaults to CANONICAL)",
          "enum": ["CANONICAL", "CYPHER", "GQL", "SQL"],
          "default": "CANONICAL"
        },
        "graphType": {
          "$ref": "#/$defs/GraphType"
        },
        "constraints": {
          "type": "object",
          "description": "A map of constraint names to constraint descriptors (optional)",
          "additionalProperties": {
            "$ref": "#/$defs/Constraint"
          }
        }
      },
      "required": ["pathName", "graphType"],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "description": "Graph instance specification - with optional schema, constraints, and storage schema",
      "properties": {
        "identifier": {
          "$ref": "#/$defs/GraphIdentifier"
        },
        "principal": {
          "type": "string",
          "description": "The owner of the graph, an authorization identifier of a principal"
        },
        "valueTypeSystemName": {
          "type": "string",
          "description": "The name of the value type system used by this graph (optional, defaults to CANONICAL)",
          "enum": ["CANONICAL", "CYPHER", "GQL", "SQL"],
          "default": "CANONICAL"
        },
        "graphSchema": {
          "$ref": "#/$defs/GraphSchemaIdentifier",
          "description": "Reference to the graph schema for this graph instance"
        },
        "constraints": {
          "type": "object",
          "description": "A map of constraint names to constraint descriptors (optional)",
          "additionalProperties": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "storageSchema": {
          "$ref": "#/$defs/StorageSchema",
          "description": "Storage schema for graph serialization/deserialization"
        }
      },
      "required": ["identifier"],
      "additionalProperties": false
    },
    "GraphSchemaIdentifier": {
      "type": "object",
      "description": "Identifier for a graph schema - supports both LQON and GQON formats",
      "oneOf": [
        {
          "description": "Locally Qualified Object Name (LQON)",
          "properties": {
            "locallyQualifiedObjectName": {
              "type": "string",
              "pattern": "^/.*",
              "description": "Path-qualified name starting with /"
            }
          },
          "required": ["locallyQualifiedObjectName"],
          "additionalProperties": false
        },
        {
          "description": "Globally Qualified Object Name (GQON)",
          "properties": {
            "globallyQualifiedObjectName": {
              "type": "string",
              "pattern": "^[^|]+\\|/.*",
              "description": "IRI|LQON format with pipe delimiter"
            }
          },
          "required": ["globallyQualifiedObjectName"],
          "additionalProperties": false
        }
      ]
    },
    "GraphIdentifier": {
      "type": "object",
      "description": "Identifier for a graph instance - supports both LQON and GQON formats",
      "oneOf": [
        {
          "description": "Locally Qualified Object Name (LQON)",
          "properties": {
            "locallyQualifiedObjectName": {
              "type": "string",
              "pattern": "^/.*",
              "description": "Path-qualified name starting with /"
            }
          },
          "required": ["locallyQualifiedObjectName"],
          "additionalProperties": false
        },
        {
          "description": "Globally Qualified Object Name (GQON)",
          "properties": {
            "globallyQualifiedObjectName": {
              "type": "string",
              "pattern": "^[^|]+\\|/.*",
              "description": "IRI|LQON format with pipe delimiter"
            }
          },
          "required": ["globallyQualifiedObjectName"],
          "additionalProperties": false
        }
      ]
    },
    "StorageSchema": {
      "type": "object",
      "description": "Storage schema for graph serialization - placeholder for future GraphAr integration",
      "properties": {
        "storageType": {
          "type": "string",
          "description": "Storage type identifier (e.g., file format)"
        }
      },
      "additionalProperties": true
    },
    "GraphType": {
      "type": "object",
      "description": "Graph type descriptor defining the structural graph type",
      "properties": {
        "graphPreferredName": {
          "type": "string",
          "enum": ["GRAPH", "PROPERTY GRAPH"],
          "description": "Implementation-defined preferred name for graph"
        },
        "nodePreferredName": {
          "type": "string",
          "enum": ["NODE", "VERTEX"],
          "description": "Implementation-defined preferred name for nodes"
        },
        "edgePreferredName": {
          "type": "string",
          "enum": ["EDGE", "RELATIONSHIP"],
          "description": "Implementation-defined preferred name for edges"
        },
        "nodeTypeMinimumLabels": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Minimum number of labels for node types (LEX:2026.0.3 - now mandatory, minimum 1)"
        },
        "nodeTypeMaximumLabels": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of labels for node types"
        },
        "nodeTypeMinimumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of property types for node types"
        },
        "nodeTypeMaximumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of property types for node types"
        },
        "edgeTypeMinimumLabels": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Minimum number of labels for edge types (LEX:2026.0.3 - now mandatory, minimum 1)"
        },
        "edgeTypeMaximumLabels": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of labels for edge types"
        },
        "edgeTypeMinimumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of property types for edge types"
        },
        "edgeTypeMaximumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of property types for edge types"
        },
        "typeInterpretation": {
          "type": "string",
          "enum": ["exactlyOfThisType", "anySubtypeOf", "anyProperSubtypeOf"],
          "default": "exactlyOfThisType",
          "description": "How types are interpreted during validation (LEX:2026.0.3)"
        },
        "import": {
          "type": "string",
          "description": "Import file path for graph type defaults"
        },
        "nodeTypes": {
          "oneOf": [
            {
              "type": "array",
              "description": "Set of node type descriptors or imports",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/NodeType"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "import": {
                        "type": "string",
                        "description": "Import individual node type from file"
                      }
                    },
                    "required": ["import"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "type": "object",
              "properties": {
                "import": {
                  "type": "string",
                  "description": "Import all node types from file"
                }
              },
              "required": ["import"],
              "additionalProperties": false
            }
          ]
        },
        "allowSubtypesOf": {
          "type": "object",
          "description": "Allow subtypes of specified element types (covariant matching)",
          "properties": {
            "abstractSupertypes": {
              "type": "object",
              "description": "Abstract supertypes that cannot be instantiated directly",
              "properties": {
                "nodeTypes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/NodeType"
                  }
                },
                "edgeTypes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/EdgeType"
                  }
                }
              },
              "additionalProperties": false
            },
            "nodeTypes": {
              "type": "array",
              "description": "Node types that allow subtypes (supertype can be instantiated)",
              "items": {
                "$ref": "#/$defs/NodeType"
              }
            },
            "edgeTypes": {
              "type": "array",
              "description": "Edge types that allow subtypes (supertype can be instantiated)",
              "items": {
                "$ref": "#/$defs/EdgeType"
              }
            }
          },
          "additionalProperties": false
        },
        "edgeTypes": {
          "oneOf": [
            {
              "type": "array",
              "description": "Set of edge type descriptors or imports",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/EdgeType"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "import": {
                        "type": "string",
                        "description": "Import individual edge type from file"
                      }
                    },
                    "required": ["import"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "type": "object",
              "properties": {
                "import": {
                  "type": "string",
                  "description": "Import all edge types from file"
                }
              },
              "required": ["import"],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "NodeType": {
      "type": "object",
      "description": "Node type descriptor with flexible identification (LEX:2026.0.3.1 - labels optional when matching typeLabel)",
      "properties": {
        "nodeType": {
          "type": "object",
          "description": "Node type container with identifier and implies",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "nodeTypeIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Integer index for node type identification"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                }
              },
              "required": ["nodeTypeIndex", "implies"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeLabel": {
                  "type": "string",
                  "pattern": "^[a-zA-Z]",
                  "description": "Single label that serves as type name (preferred in LEX:2026.0.3)"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                }
              },
              "required": ["typeLabel", "implies"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeIdentifyingLabels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z]"
                  },
                  "uniqueItems": true,
                  "minItems": 1,
                  "description": "Set of labels that uniquely identify this type"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                }
              },
              "required": ["typeIdentifyingLabels", "implies"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["nodeType"],
      "additionalProperties": false
    },
    "ImpliesDescriptor": {
      "type": "object",
      "description": "Container for supertypes, labels, and property types (LEX:2026.0.3 structure)",
      "properties": {
        "supertypes": {
          "type": "array",
          "description": "Set of supertype labels (LEX:2026.0.3 - enables subtyping)",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "labels": {
          "type": "array",
          "description": "Set of labels for this type (optional if only typeLabel)",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "propertyTypes": {
          "oneOf": [
            {
              "type": "array",
              "description": "Set of property type descriptors",
              "items": {
                "$ref": "#/$defs/PropertyType"
              }
            },
            {
              "type": "string",
              "pattern": "^\\$ref\\(",
              "description": "Import property types via $ref"
            }
          ]
        },
        "extensionInterpretation": {
          "type": "object",
          "description": "Controls whether type can be extended (LEX:2026.0.3)",
          "properties": {
            "open": {
              "type": "boolean",
              "description": "If true, allows undefined subtypes"
            },
            "closed": {
              "type": "boolean",
              "description": "If true, only defined subtypes allowed (default)"
            }
          },
          "oneOf": [
            {"required": ["open"]},
            {"required": ["closed"]}
          ]
        }
      },
      "required": ["propertyTypes"],
      "additionalProperties": false
    },
    "NodeTypeIdentifier": {
      "description": "Flexible node type identification - index, type name label, or type identifying labels",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "nodeTypeIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "Integer index for node type identification"
            }
          },
          "required": ["nodeTypeIndex"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "typeLabel": {
              "type": "string",
              "pattern": "^[a-zA-Z]",
              "description": "Single label that serves as type name (preferred in LEX:2026.0.3)"
            }
          },
          "required": ["typeLabel"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "typeIdentifyingLabels": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z]"
              },
              "uniqueItems": true,
              "minItems": 1,
              "description": "Set of labels that uniquely identify this type"
            }
          },
          "required": ["typeIdentifyingLabels"],
          "additionalProperties": false
        }
      ]
    },
    "EdgeType": {
      "type": "object",
      "description": "Edge type descriptor with flexible identification (LEX:2026.0.3.1 - labels optional when matching typeLabel)",
      "properties": {
        "edgeType": {
          "type": "object",
          "description": "Edge type container with identifier, implies, direction, and endpoints",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "edgeTypeIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Integer index for edge type identification"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                },
                "direction": {
                  "type": "string",
                  "enum": ["DIRECTED", "UNDIRECTED"],
                  "description": "Edge direction"
                },
                "firstEndpointNodeType": {
                  "$ref": "#/$defs/NodeTypeIdentifier",
                  "description": "First endpoint node type identifier"
                },
                "secondEndpointNodeType": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["SAME"],
                      "description": "Same as first endpoint (loop edge)"
                    },
                    {
                      "$ref": "#/$defs/NodeTypeIdentifier",
                      "description": "Second endpoint node type identifier"
                    }
                  ]
                }
              },
              "required": ["edgeTypeIndex", "implies", "direction", "firstEndpointNodeType", "secondEndpointNodeType"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeLabel": {
                  "type": "string",
                  "pattern": "^[a-zA-Z]",
                  "description": "Single label that serves as type name (preferred in LEX:2026.0.3)"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                },
                "direction": {
                  "type": "string",
                  "enum": ["DIRECTED", "UNDIRECTED"],
                  "description": "Edge direction"
                },
                "firstEndpointNodeType": {
                  "$ref": "#/$defs/NodeTypeIdentifier",
                  "description": "First endpoint node type identifier"
                },
                "secondEndpointNodeType": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["SAME"],
                      "description": "Same as first endpoint (loop edge)"
                    },
                    {
                      "$ref": "#/$defs/NodeTypeIdentifier",
                      "description": "Second endpoint node type identifier"
                    }
                  ]
                }
              },
              "required": ["typeLabel", "implies", "direction", "firstEndpointNodeType", "secondEndpointNodeType"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "typeIdentifyingLabels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z]"
                  },
                  "uniqueItems": true,
                  "minItems": 1,
                  "description": "Set of labels that uniquely identify this type"
                },
                "implies": {
                  "$ref": "#/$defs/ImpliesDescriptor"
                },
                "direction": {
                  "type": "string",
                  "enum": ["DIRECTED", "UNDIRECTED"],
                  "description": "Edge direction"
                },
                "firstEndpointNodeType": {
                  "$ref": "#/$defs/NodeTypeIdentifier",
                  "description": "First endpoint node type identifier"
                },
                "secondEndpointNodeType": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["SAME"],
                      "description": "Same as first endpoint (loop edge)"
                    },
                    {
                      "$ref": "#/$defs/NodeTypeIdentifier",
                      "description": "Second endpoint node type identifier"
                    }
                  ]
                }
              },
              "required": ["typeIdentifyingLabels", "implies", "direction", "firstEndpointNodeType", "secondEndpointNodeType"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["edgeType"],
      "additionalProperties": false
    },
    "EdgeTypeIdentifier": {
      "description": "Flexible edge type identification - index, type name label, or type identifying labels",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "edgeTypeIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "Integer index for edge type identification"
            }
          },
          "required": ["edgeTypeIndex"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "typeLabel": {
              "type": "string",
              "pattern": "^[a-zA-Z]",
              "description": "Single label that serves as type name (preferred in LEX:2026.0.3)"
            }
          },
          "required": ["typeLabel"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "typeIdentifyingLabels": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z]"
              },
              "uniqueItems": true,
              "minItems": 1,
              "description": "Set of labels that uniquely identify this type"
            }
          },
          "required": ["typeIdentifyingLabels"],
          "additionalProperties": false
        }
      ]
    },
    "PropertyType": {
      "type": "object",
      "description": "Property type descriptor",
      "properties": {
        "name": {
          "type": "string",
          "description": "Property name"
        },
        "valueType": {
          "type": "string",
          "enum": [
            "STRING", "INTEGER", "FLOAT", "BOOLEAN", "VECTOR",
            "LIST", "RECORD", "DATE", "LOCAL TIME", "ZONED TIME",
            "LOCAL DATETIME", "ZONED DATETIME", "DURATION", "JSON"
          ],
          "description": "Value type name from the canonical VTS"
        },
        "notNull": {
          "type": "boolean",
          "description": "Whether the property is NOT NULL (default: false, meaning nullable)"
        }
      },
      "required": ["name", "valueType"],
      "additionalProperties": false
    },
    "Constraint": {
      "type": "object",
      "description": "Constraint descriptor",
      "properties": {
        "name": {
          "type": "string",
          "description": "Constraint name"
        },
        "rule": {
          "$ref": "#/$defs/ConstraintRule"
        }
      },
      "required": ["name", "rule"],
      "additionalProperties": false
    },
    "ConstraintRule": {
      "type": "object",
      "description": "Constraint rule descriptor",
      "properties": {
        "subject": {
          "type": "string",
          "enum": ["KEY", "UNIQUE"],
          "description": "Constraint subject type"
        },
        "constraintPattern": {
          "type": "string",
          "description": "Constraint pattern specification"
        },
        "uniqueKeyComponentPropertyNames": {
          "type": "array",
          "description": "Set of property names for unique key components",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": ["subject", "constraintPattern", "uniqueKeyComponentPropertyNames"],
      "additionalProperties": false
    },
    "canonicalBoolean": {
      "data.boolean": {
        "type": "boolean"
      },
      "gql.boolean": "BOOLEAN",
      "sql.boolean": "BOOLEAN",
      "canonical.boolean": "BOOLEAN"
    },
    "canonicalString": {
      "data.string": {
        "type": "string",
        "maxLength": {"type": "integer", "minimum": 0}
      },
      "gql.string": "STRING",
      "sql.string": "VARCHAR",
      "canonical.string": "STRING"
    },
    "canonicalInteger": {
      "data.int64": {
        "type": "integer",
        "minimum": -9223372036854775808,
        "maximum": 9223372036854775807
      },
      "gql.int64": "BIGINT",
      "sql.int64": "BIGINT",
      "canonical.int64": "INTEGER"
    },
    "canonicalFloat": {
      "data.float64": {
        "type": "number"
      },
      "gql.float64": "DOUBLE",
