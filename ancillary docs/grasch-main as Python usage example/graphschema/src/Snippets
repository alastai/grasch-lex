from typing import Union

class Permissions:
    def __init__(self, can_read: bool = False, can_write: bool = False, can_execute: bool = False):
        self.can_read = can_read
        self.can_write = can_write
        self.can_execute = can_execute

    def __or__(self, other: 'Permissions') -> 'Permissions':
        return Permissions(
            self.can_read or other.can_read,
            self.can_write or other.can_write,
            self.can_execute or other.can_execute
        )

    def __str__(self):
        return f"Permissions(read={self.can_read}, write={self.can_write}, execute={self.can_execute})"


# Example usage
perm1 = Permissions(can_read=True, can_write=False)
perm2 = Permissions(can_write=True, can_execute=True)
combined_perm = perm1 | perm2
