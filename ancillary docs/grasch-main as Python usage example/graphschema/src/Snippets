class Foo:
    def __init__(self):
        pass

    def multiply(self, x, y):
        return x * y

class FooSub(Foo):
    def __init__(self, x: int, y: int):
        super().__init__()
        self._x = x
        self._y = y

    def product(self) -> int:
        return super().multiply(x=self._x, y=self._y)

    def __str__(self):
        return str(self.product())

    def __hash__(self):
        #return hash((super().__hash__(), self.product()))

        return hash(self.product())

    def __eq__(self, other):
        return super().__eq__(other) and self.product() == other.product()

