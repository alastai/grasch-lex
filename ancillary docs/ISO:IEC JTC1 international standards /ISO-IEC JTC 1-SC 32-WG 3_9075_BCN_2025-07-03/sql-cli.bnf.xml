            <terminalsymbol>GetDescRec</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>GetDiagField</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>GetDiagRec</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>GetEnvAttr</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>GetFeatureInfo</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>GetFunctions</terminalsymbol>
         </alt>
