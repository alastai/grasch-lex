<?xml version="1.0" encoding="UTF-8"?>
<!--The following XML document is a "digital artifact" containing an XML element("conditions") that
identifies every condition, except for those conditions already defined in ISO/IEC 9075-2, that is generated by an implementation of this part of ISO/IEC 9075.

An XML DTD is provided that may be used to validate the XML document itself. 

It may be used by implementers to specify the natural-language text that is reported whenever
any of the various conditions are generated by evaluation of SQL 
expressions and execution of SQL statements.  
It may also be used by documentation writers and translators to document those conditions in the 
natural languages of users of SQL-implementations.  
  -->
 
<!DOCTYPE conditions [
  
<!-- The conditions element defines the conditions (completion or exception) for a set of standards.
-->
<!ELEMENT conditions ((class)*)>


<!-- A class element defines the class code of an SQLSTATE or GQLSTATUS value.
-->
<!ELEMENT class (subclass*)>
<!-- The attributes of class are:
      * category is the category of the class of conditions:
        - S - Successful Completion
        - N - No Data
        - W - Warning
        - I - Informational
        - X - Exception
      * code is the unique class code of the class of conditions.
      * name is the unique natural language name of the class of conditions.
-->
<!ATTLIST class
    category ( S | N | W | I | X ) #REQUIRED
    code CDATA #REQUIRED
    name CDATA #REQUIRED
>


<!-- A subclass element defines the subclass code of an SQLSTATE or GQLSTATUS value.
-->
<!ELEMENT subclass EMPTY>
<!-- The attribute of subclass are:
      * code is the unique subclass code of the subclass within the class.
      * name is the unique natural language name of the subclass within the class.
-->
<!ATTLIST subclass
    code CDATA #REQUIRED
    name CDATA #REQUIRED
>

]>

<conditions>
   <class category="W" code="01" name="warning">
      <subclass code="011" name="SQL-Java path too long for information schema"/>
   </class>
   <class category="X" code="46" name="Java-related condition">
      <subclass code="001" name="invalid URL"/>
      <subclass code="002" name="invalid JAR name"/>
      <subclass code="003" name="invalid class deletion"/>
      <subclass code="005" name="invalid replacement"/>
      <subclass code="00A" name="attempt to replace uninstalled JAR"/>
      <subclass code="00B" name="attempt to remove uninstalled JAR"/>
      <subclass code="00C" name="invalid JAR removal"/>
      <subclass code="00D" name="invalid path"/>
      <subclass code="00E" name="self-referencing path"/>
      <subclass code="102" name="invalid JAR name in path"/>
      <subclass code="103" name="unresolved class name"/>
   </class>
</conditions>
