{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/minimal-customer-schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 6
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "shipping_address": {
      "$ref": "#/$defs/address"
    },
    "billing_address": {
      "$ref": "#/$defs/address"
    },
    "date_of_birth": {
      "$ref": "type-definitions#/gql.date"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "shipping_address"
  ],
  "$defs": {
    "address": {
      "$id": "address",
      "type": "object",
      "properties": {
        "street_address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "enum": [
            "happy",
            "sad",
            "pathetic"
          ]
        }
      }
    }
  }
}