# Comprehensive Type Interpretation Wrapper Examples
# Demonstrates all wrapper patterns and edge type component-level interpretations

graphSchema:
  pathName: /examples/comprehensive-wrappers
  
  graphType:
    propertyGraphDataModel:
      valueTypeSystemName: CANONICAL
    
    # Individual item wrappers with mixed patterns
    nodeTypes:
      - nodeType:
          typeLabel: Person
      - nodeType:
          typeLabel: Organization
      - abstract:
          nodeType:
            typeLabel: Entity
      - subtypesOf:
          concrete:
            nodeType:
              typeLabel: Company
    
    # Individual item wrappers (Task 6.6)
    edgeTypes:
      - edgeType:
          directed:
            from: Person
            to: Person
            via:
              typeLabel: KNOWS
      
      # Wrapper around entire edgeType (Task 6.9)
      - subtypesOf:
          abstract:
            edgeType:
              directed:
                from:
                  subtypesOf:
                    abstract: Entity
                to:
                  subtypesOf:
                    abstract: Entity
                via:
                  typeLabel: RELATIONSHIP
      
      # Component-level wrappers on node type references
      - edgeType:
          directed:
            from:
              exactlyOf:
                concrete: Person
            to:
              subtypesOf:
                abstract: Person
            via:
              typeLabel: MANAGES
      
      # Undirected edge with component wrappers on node type references
      - edgeType:
          undirected:
            between:
              subtypesOf:
                concrete: Person
            and:
              subtypesOf:
                concrete: Person
            arc:
              typeLabel: FRIEND
