{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grasch.org/schemas/lex-graph-schema.json",
  "title": "LEX:2026.0.1 Graph Schema",
  "description": "JSON Schema for LEX:2026.0.1 Graph Schema - concrete syntax for the Abstract Syntax for Graph Schema as defined in LEX-100r1",
  "type": "object",
  "properties": {
    "identifier": {
      "$ref": "#/$defs/GraphSchemaIdentifier"
    },
    "principal": {
      "type": "string",
      "description": "The owner of the graph schema, an authorization identifier of a principal"
    },
    "valueTypeSystemName": {
      "type": "string",
      "description": "The name of the value type system used by this graph schema (optional, defaults to CANONICAL)",
      "enum": ["CANONICAL", "CYPHER", "GQL", "SQL"],
      "default": "CANONICAL"
    },
    "graphType": {
      "$ref": "#/$defs/GraphType"
    },
    "constraints": {
      "type": "object",
      "description": "A map of constraint names to constraint descriptors (optional)",
      "additionalProperties": {
        "$ref": "#/$defs/Constraint"
      }
    }
  },
  "required": ["identifier", "graphType"],
  "additionalProperties": false,
  "$defs": {
    "GraphSchemaIdentifier": {
      "type": "object",
      "description": "Identifier for a graph schema",
      "properties": {
        "root": {
          "type": "string",
          "format": "iri",
          "description": "Optional root IRI"
        },
        "directory": {
          "type": "array",
          "description": "Directory path components",
          "items": {
            "type": "string"
          }
        },
        "typesGraphsDirectory": {
          "type": "string",
          "description": "Optional types-graphs-directory name"
        },
        "name": {
          "type": "string",
          "description": "The name of the graph schema"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "GraphType": {
      "type": "object",
      "description": "A graph type descriptor that describes the structure of conformant data graphs",
      "properties": {
        "graphPreferredName": {
          "type": "string",
          "enum": ["GRAPH", "PROPERTY GRAPH"],
          "description": "The preferred name for graphs of this type"
        },
        "nodePreferredName": {
          "type": "string",
          "enum": ["NODE", "VERTEX"],
          "description": "The preferred name for nodes in this graph type"
        },
        "edgePreferredName": {
          "type": "string",
          "enum": ["EDGE", "RELATIONSHIP"],
          "description": "The preferred name for edges in this graph type"
        },
        "nodeTypeMinimumLabels": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of labels required for node types"
        },
        "nodeTypeMaximumLabels": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of labels allowed for node types"
        },
        "nodeTypeMinimumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of property types required for node types"
        },
        "nodeTypeMaximumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of property types allowed for node types"
        },
        "edgeTypeMinimumLabels": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of labels required for edge types"
        },
        "edgeTypeMaximumLabels": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of labels allowed for edge types"
        },
        "edgeTypeMinimumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of property types required for edge types"
        },
        "edgeTypeMaximumPropertyTypes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of property types allowed for edge types"
        },
        "nodeTypes": {
          "type": "array",
          "description": "Set of node type descriptors",
          "items": {
            "$ref": "#/$defs/NodeType"
          }
        },
        "edgeTypes": {
          "type": "array",
          "description": "Set of edge type descriptors",
          "items": {
            "$ref": "#/$defs/EdgeType"
          }
        },
        "nodeTypeKeyLabelSetDictionary": {
          "type": "object",
          "description": "Maps key label sets to node types",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "description": "Index of the node type"
          }
        },
        "edgeTypeKeyLabelSetDictionary": {
          "type": "object",
          "description": "Maps key label sets to edge types (no indices for edge types)",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Label set identifying the edge type"
          }
        }
      },
      "required": [
        "graphPreferredName",
        "nodePreferredName", 
        "edgePreferredName",
        "nodeTypeMinimumLabels",
        "nodeTypeMaximumLabels",
        "nodeTypeMinimumPropertyTypes",
        "nodeTypeMaximumPropertyTypes",
        "edgeTypeMinimumLabels",
        "edgeTypeMaximumLabels",
        "edgeTypeMinimumPropertyTypes",
        "edgeTypeMaximumPropertyTypes",
        "nodeTypes",
        "edgeTypes",
        "nodeTypeKeyLabelSetDictionary",
        "edgeTypeKeyLabelSetDictionary"
      ],
      "additionalProperties": false
    },
    "NodeType": {
      "type": "object",
      "description": "A node type descriptor",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Unique integer index for this node type within the graph type (used for edge endpoint references)"
        },
        "labels": {
          "type": "array",
          "description": "Set of labels for this node type",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "propertyTypes": {
          "type": "array",
          "description": "Set of property type descriptors for this node type",
          "items": {
            "$ref": "#/$defs/PropertyType"
          }
        }
      },
      "required": ["index", "labels", "propertyTypes"],
      "additionalProperties": false
    },
    "EdgeType": {
      "type": "object",
      "description": "An edge type descriptor (no index field - edge types are not indexed)",
      "properties": {
        "labels": {
          "type": "array",
          "description": "Set of labels for this edge type",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "propertyTypes": {
          "type": "array",
          "description": "Set of property type descriptors for this edge type",
          "items": {
            "$ref": "#/$defs/PropertyType"
          }
        },
        "direction": {
          "type": "string",
          "enum": ["DIRECTED", "UNDIRECTED"],
          "description": "Whether the edge type is directed or undirected"
        },
        "firstEndpointNodeType": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of the first endpoint node type"
        },
        "secondEndpointNodeType": {
          "oneOf": [
            {
              "type": "string",
              "const": "SAME",
              "description": "Indicates the second endpoint is the same as the first (loop edge)"
            },
            {
              "type": "integer",
              "minimum": 0,
              "description": "Index of the second endpoint node type"
            }
          ]
        }
      },
      "required": ["labels", "propertyTypes", "direction", "firstEndpointNodeType", "secondEndpointNodeType"],
      "additionalProperties": false
    },
    "PropertyType": {
      "type": "object",
      "description": "A property type descriptor",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the property"
        },
        "valueType": {
          "$ref": "#/$defs/ValueType"
        }
      },
      "required": ["name", "valueType"],
      "additionalProperties": false
    },
    "ValueType": {
      "type": "object",
      "description": "A value type descriptor with name and optional parameters",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the value type from the value type system",
          "enum": ["STRING", "INTEGER", "FLOAT", "BOOLEAN", "VECTOR", "LIST", "RECORD", "DATE", "LOCAL TIME", "ZONED TIME", "LOCAL DATETIME", "ZONED DATETIME", "DURATION", "LIST_OF", "MAP"]
        },
        "parameters": {
          "type": "object",
          "description": "Map of parameter names to parameter values",
          "additionalProperties": true
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Constraint": {
      "type": "object",
      "description": "A constraint descriptor",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the constraint"
        },
        "rule": {
          "$ref": "#/$defs/ConstraintRule"
        }
      },
      "required": ["name", "rule"],
      "additionalProperties": false
    },
    "ConstraintRule": {
      "type": "object",
      "description": "A constraint rule descriptor",
      "properties": {
        "subject": {
          "type": "string",
          "enum": ["KEY", "UNIQUE"],
          "description": "The type of constraint"
        },
        "constraintPattern": {
          "type": "string",
          "description": "The constraint pattern specification"
        },
        "uniqueKeyComponentPropertyNames": {
          "type": "array",
          "description": "Set of property names that form the unique key components",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": ["subject", "constraintPattern", "uniqueKeyComponentPropertyNames"],
      "additionalProperties": false
    }
  }
}
