      <subclass code="009" name="invalid use of null pointer"/>
      <subclass code="010" name="function sequence error"/>
      <subclass code="011" name="attribute cannot be set now"/>
      <subclass code="012" name="invalid transaction operation code"/>
      <subclass code="013" name="memory management error"/>
      <subclass code="014" name="limit on number of handles exceeded"/>
      <subclass code="016" name="cannot modify an implementation row descriptor"/>
      <subclass code="017"
                name="invalid use of automatically-allocated descriptor handle"/>
      <subclass code="018" name="server declined the cancellation request"/>
