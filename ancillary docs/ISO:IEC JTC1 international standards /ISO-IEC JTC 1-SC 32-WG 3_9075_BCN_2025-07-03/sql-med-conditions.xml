<?xml version="1.0" encoding="UTF-8"?>
<!--The following XML document is a "digital artifact" containing an XML element("conditions") that
identifies every condition, except for those conditions already defined in ISO/IEC 9075-2, that is generated by an implementation of this part of ISO/IEC 9075.

An XML DTD is provided that may be used to validate the XML document itself. 

It may be used by implementers to specify the natural-language text that is reported whenever
any of the various conditions are generated by evaluation of SQL 
expressions and execution of SQL statements.  
It may also be used by documentation writers and translators to document those conditions in the 
natural languages of users of SQL-implementations.  
  -->
 
<!DOCTYPE conditions [
  
<!-- The conditions element defines the conditions (completion or exception) for a set of standards.
-->
<!ELEMENT conditions ((class)*)>


<!-- A class element defines the class code of an SQLSTATE or GQLSTATUS value.
-->
<!ELEMENT class (subclass*)>
<!-- The attributes of class are:
      * category is the category of the class of conditions:
        - S - Successful Completion
        - N - No Data
        - W - Warning
        - I - Informational
        - X - Exception
      * code is the unique class code of the class of conditions.
      * name is the unique natural language name of the class of conditions.
-->
<!ATTLIST class
    category ( S | N | W | I | X ) #REQUIRED
    code CDATA #REQUIRED
    name CDATA #REQUIRED
>


<!-- A subclass element defines the subclass code of an SQLSTATE or GQLSTATUS value.
-->
<!ELEMENT subclass EMPTY>
<!-- The attribute of subclass are:
      * code is the unique subclass code of the subclass within the class.
      * name is the unique natural language name of the subclass within the class.
-->
<!ATTLIST subclass
    code CDATA #REQUIRED
    name CDATA #REQUIRED
>

]>

<conditions>
   <class category="X" code="0X" name="invalid foreign server specification"/>
   <class category="X" code="0Y" name="pass-through specific condition">
      <subclass code="001" name="invalid cursor option"/>
      <subclass code="002" name="invalid cursor allocation"/>
   </class>
   <class category="X" code="22" name="data exception">
      <subclass code="017" name="invalid data specified for datalink"/>
      <subclass code="01A" name="null argument passed to datalink constructor"/>
      <subclass code="01D" name="datalink value exceeds maximum length"/>
   </class>
   <class category="X" code="HV" name="FDW-specific condition">
      <subclass code="001" name="memory allocation error"/>
      <subclass code="004" name="invalid data type"/>
      <subclass code="005" name="column name not found"/>
      <subclass code="006" name="invalid data type descriptors"/>
      <subclass code="007" name="invalid column name"/>
      <subclass code="009" name="invalid use of null pointer"/>
      <subclass code="00A" name="invalid string format"/>
      <subclass code="00B" name="invalid handle"/>
      <subclass code="00C" name="invalid option index"/>
      <subclass code="00D" name="invalid option name"/>
      <subclass code="00J" name="option name not found"/>
      <subclass code="00L" name="unable to create execution"/>
      <subclass code="00M" name="unable to create reply"/>
      <subclass code="00N" name="unable to establish connection"/>
      <subclass code="00P" name="no schemas"/>
      <subclass code="00Q" name="schema not found"/>
      <subclass code="00R" name="table not found"/>
      <subclass code="010" name="function sequence error"/>
      <subclass code="014" name="limit on number of handles exceeded"/>
      <subclass code="021" name="inconsistent descriptor information"/>
      <subclass code="024" name="invalid attribute value"/>
      <subclass code="090" name="invalid string length or buffer length"/>
      <subclass code="091" name="invalid descriptor field identifier"/>
   </class>
   <class category="X" code="HW" name="datalink exception">
      <subclass code="001" name="external file not linked"/>
      <subclass code="002" name="external file already linked"/>
      <subclass code="003" name="referenced file does not exist"/>
      <subclass code="004" name="invalid write token"/>
      <subclass code="005" name="invalid datalink construction"/>
      <subclass code="006" name="invalid write permission for update"/>
      <subclass code="007" name="referenced file not valid"/>
   </class>
   <class category="X" code="HY" name="CLI-specific condition">
      <subclass code="092" name="invalid attribute identifier"/>
      <subclass code="093" name="invalid datalink value"/>
   </class>
</conditions>
