         <alt>
            <terminalsymbol>ColAttribute</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>ColumnPrivileges</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>Columns</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>Connect</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>CopyDesc</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>DataSources</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>DescribeCol</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>Disconnect</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>EndTran</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>Error</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>ExecDirect</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>Execute</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>Fetch</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>FetchScroll</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>ForeignKeys</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>FreeConnect</terminalsymbol>
         </alt>
         <alt>
            <terminalsymbol>FreeEnv</terminalsymbol>
