         </alt>
      </rhs>
   </BNFdef>
   <BNFdef name="CLI parameter list" predicative="no">
      <rhs>
         <BNF name="left paren" part="02"/>
         <BNF name="CLI parameter declaration"/>
         <opt>
            <group>
               <BNF name="comma" part="02"/>
               <BNF name="CLI parameter declaration"/>
            </group>
            <repeat/>
         </opt>
         <BNF name="right paren" part="02"/>
      </rhs>
   </BNFdef>
   <BNFdef name="CLI parameter declaration" predicative="no">
      <rhs>
         <BNF name="CLI parameter name"/>
