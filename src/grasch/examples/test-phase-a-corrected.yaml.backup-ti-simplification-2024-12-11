# Phase A Test: NodeType with TI wrappers (CORRECTED SYNTAX)
# Tests 0-level (bare), 1-level (shorthand), and 2-level (explicit) TI wrappers

graphSchema:
  pathName: /test/phase-a
  graphType:
    propertyGraphDataModel:
      valueTypeSystemName: CANONICAL
    
    nodeTypes:
      # 0-level: Bare nodeType (implicit exactlyOf: concrete:)
      - nodeType:
          typeLabel: Person
          implies:
            labels: [Person]
            propertyTypes:
              - name: name
                valueType: STRING
              - name: age
                valueType: INTEGER
      
      # 1-level: Shorthand - abstract
      - abstract:
          nodeType:
            typeLabel: Vehicle
            implies:
              labels: [Vehicle]
              propertyTypes:
                - name: make
                  valueType: STRING
                - name: model
                  valueType: STRING
      
      # 1-level: Shorthand - concrete
      - concrete:
          nodeType:
            typeLabel: Product
            implies:
              labels: [Product]
              propertyTypes:
                - name: sku
                  valueType: STRING
                - name: price
                  valueType: FLOAT
      
      # 1-level: Shorthand - final
      - final:
          nodeType:
            typeLabel: Company
            implies:
              labels: [Company]
              propertyTypes:
                - name: name
                  valueType: STRING
      
      # 1-level: Shorthand - properSubtypesOf
      - properSubtypesOf:
          nodeType:
            typeLabel: Asset
            implies:
              labels: [Asset]
              propertyTypes:
                - name: value
                  valueType: FLOAT
      
      # 2-level: Explicit - exactlyOf: concrete:
      - exactlyOf:
          concrete:
            nodeType:
              typeLabel: Employee
              implies:
                labels: [Employee]
                propertyTypes:
                  - name: employeeId
                    valueType: STRING
      
      # 2-level: Explicit - exactlyOf: abstract:
      - exactlyOf:
          abstract:
            nodeType:
              typeLabel: Entity
              implies:
                labels: [Entity]
                propertyTypes:
                  - name: id
                    valueType: STRING
      
      # 2-level: Explicit - subtypesOf: concrete:
      - subtypesOf:
          concrete:
            nodeType:
              typeLabel: Manager
              implies:
                labels: [Manager]
                propertyTypes:
                  - name: department
                    valueType: STRING
      
      # 2-level: Explicit - subtypesOf: abstract:
      - subtypesOf:
          abstract:
            nodeType:
              typeLabel: Organization
              implies:
                labels: [Organization]
                propertyTypes:
                  - name: name
                    valueType: STRING
      
      # 2-level: Explicit - properSubtypesOf: concrete: (NEW!)
      - properSubtypesOf:
          concrete:
            nodeType:
              typeLabel: Director
              implies:
                labels: [Director]
                propertyTypes:
                  - name: division
                    valueType: STRING
      
      # 2-level: Explicit - properSubtypesOf: abstract: (NEW!)
      - properSubtypesOf:
          abstract:
            nodeType:
              typeLabel: Resource
              implies:
                labels: [Resource]
                propertyTypes:
                  - name: resourceId
                    valueType: STRING
